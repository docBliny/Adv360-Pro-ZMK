#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include "include/adv360.h"
#include "include/keys.h"

/ {
    behaviors {
        #include "macros.dtsi"
        #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        mo_tog: behavior_mo_tog {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&tog>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL  &kp N1               &kp N2           &kp N3           &kp N4             &kp N5   &tog 1                                                                     &mo 5          &kp N6   &kp N7              &kp N8            &kp N9            &kp N0                &kp MINUS
&kp TAB    &kp Q                &kp W            &kp F            &kp P              &kp B    &none                                                                      &none          &kp J    &kp L               &kp U             &kp Y             &kp SEMICOLON         &kp BSLH
&kp ESC    &hml LEFT_CONTROL A  &hml LEFT_ALT R  &hml LEFT_GUI S  &hml LEFT_SHIFT T  &lt 2 G  &mo_tog 3 2  &kp LEFT_GUI  &kp LALT      &kp RIGHT_CONTROL  &kp RIGHT_GUI  &mo_tog 3 2    &lt 2 M  &hmr RIGHT_SHIFT N  &hmr RIGHT_GUI E  &hmr RIGHT_ALT I  &hmr RIGHT_CONTROL O  &kp SQT
&sk LSHFT  &kp Z                &kp X            &kp C            &kp D              &kp V                               &kp HOME      &kp PG_UP                                        &kp K    &kp H               &kp COMMA         &kp DOT           &kp FSLH              &sk RSHFT
&to 2      &kp GRAVE            &kp CAPS         &kp LEFT         &kp RIGHT                   &kp SPACE    &kp DEL       &kp END       &kp PG_DN          &kp ENTER      &kp BACKSPACE           &kp UP              &kp DOWN          &kp LBKT          &kp RBKT              &mo_tog 3 3
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 1                                      &mo 3   &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans   &trans   &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans   &trans   &trans
            >;
        };

        red {
            display-name = "Navigation";
            label = "Red";
            bindings = <
&trans  &trans     &trans     &trans     &trans         &trans     &trans                                      &trans  &trans             &trans                    &trans                     &trans         &trans  &trans
&trans  &trans     &trans     &kp LC(F)  &kp LS(LG(P))  &trans     &trans                                      &trans  &kp PG_UP          &kp HOME                  &kp UP                     &kp END        &trans  &trans
&trans  &kp LCTRL  &kp LALT   &kp RGUI   &kp LSHFT      &trans     &trans  &trans  &trans      &trans  &trans  &trans  &kp PG_DN          &kp LEFT                  &kp DOWN                   &kp RIGHT      &trans  &trans
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)  &kp LS(LG(V))  &kp LG(V)                  &trans      &trans                  &kp RS(RG(GRAVE))  &kp RS(RG(LEFT_BRACKET))  &kp RS(RG(RIGHT_BRACKET))  &kp RG(GRAVE)  &trans  &trans
&to 0   &trans     &trans     &trans     &trans                    &trans  &trans  &trans      &trans  &trans  &trans                     &kp K_BACK                &kp K_FORWARD              &trans         &trans  &to 0
            >;
        };

        green {
            display-name = "Symbols";
            label = "Green";
            bindings = <
&trans  &trans           &trans         &trans            &trans             &trans         &trans                                      &trans  &trans       &trans                &trans                 &trans         &trans             &trans
&trans  &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE       &trans                                      &trans  &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &trans             &trans
&trans  &kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND  &trans  &trans  &trans      &trans  &trans  &trans  &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES  &trans
&trans  &kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT                    &trans      &trans                  &kp AT_SIGN  &kp COLON             &kp COMMA              &kp PERIOD     &kp SQT            &trans
&to 0   &trans           &trans         &trans            &trans                            &trans  &trans  &trans      &trans  &trans  &trans               &trans                &trans                 &trans         &trans             &to 0
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&kp EQUAL  &kp N1           &kp N2         &kp N3            &kp N4             &kp N5         &trans                                                   &trans     &kp N6       &kp KP_NUM            &kp KP_EQUAL           &kp KP_DIVIDE  &kp KP_MULTIPLY    &kp MINUS
&kp TAB    &kp GRAVE        &kp LESS_THAN  &kp GREATER_THAN  &kp MINUS          &kp PIPE       &none                                                    &none      &kp CARET    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp DOLLAR     &kp KP_MINUS       &kp BSLH
&kp ESC    &kp EXCLAMATION  &kp ASTERISK   &kp SLASH         &kp EQUAL          &kp AMPERSAND  &none     &kp LCTRL  &kp LALT      &kp LGUI   &kp RCTRL  &none      &kp HASH     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp SEMICOLON  &kp DOUBLE_QUOTES  &kp SQT
&kp LSHFT  &kp TILDE        &kp PLUS       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp PERCENT                         &kp HOME      &kp PG_UP                        &kp AT_SIGN  &kp COLON             &kp COMMA              &kp PERIOD     &kp SINGLE_QUOTE   &kp RSHFT
&mo 2      &kp GRAVE        &kp CAPS       &kp LEFT          &kp RIGHT                         &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0               &kp UP                &kp DOWN               &kp KP_DOT     &kp RBKT           &mo 2
            >;
        };

        mod {
            display-name = "Mod";
            label = "Purple";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none  &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &macro_ver    &none                             &none      &none                                    &none  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG         &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        cyan {
            display-name = "Cyan";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        yellow {
            display-name = "Yellow";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
